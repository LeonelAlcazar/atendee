{
  "name": "atende",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:content && next build && node scripts/prepare-standalone.mjs",
    "test": "vitest run",
    "check:seo": "tsx scripts/check-site.mjs",
    "verify": "npm test && tsc --noEmit && npm run build && npm run check:seo",
